# Скопируйте этот файл в .env.local и подставьте свои значения.
# .env.local в .gitignore и не попадает в репозиторий.

# TMDB: https://www.themoviedb.org/settings/api
# "API Read Access Token" (длинный токен, начинается с eyJ...)
TMDB_READ_ACCESS_TOKEN=

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Telegram-бот (необязательно). Токен выдаёт @BotFather после команды /newbot.
TELEGRAM_BOT_TOKEN=
# Имя бота без @, например reviews_films_bot
TELEGRAM_BOT_USERNAME=
# Supabase: Project Settings → API Keys → service_role (secret).
# Даёт полный доступ к базе: только на сервере, никогда не добавляйте NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
